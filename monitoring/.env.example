# Скопируй в .env и заполни реальными значениями:
# cp .env.example .env

# Telegram бот для алертов Grafana
# Создать бота: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата куда слать алерты
# Узнать: написать боту, открыть https://api.telegram.org/bot<TOKEN>/getUpdates
# Поле: result[0].message.chat.id
TELEGRAM_CHAT_ID=your_chat_id_here
