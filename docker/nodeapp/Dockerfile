# Изменён: 2026-03-24 — добавлен не-root пользователь в продакшн образ (безопасность)

# ─────────────────────────────────────────
# ЭТАП 1: builder — сборка зависимостей
# ─────────────────────────────────────────
# Multi-stage build: используем два этапа чтобы финальный образ был меньше
# "AS builder" — даём этапу имя, чтобы скопировать из него файлы ниже
FROM node:18-alpine AS builder

# Рабочая директория внутри контейнера
# Все последующие команды выполняются относительно неё
WORKDIR /app

# Сначала копируем только package*.json (package.json + package-lock.json)
# Это кеш-оптимизация: если код изменился, но зависимости нет —
# Docker не будет переустанавливать npm пакеты (слой с npm install закеширован)
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь остальной код приложения
COPY . .

# ─────────────────────────────────────────
# ЭТАП 2: продакшн образ
# ─────────────────────────────────────────
# Начинаем чистый образ — без dev зависимостей и кешей от сборки
FROM node:18-alpine

# Создаём отдельную группу и пользователя для запуска приложения
# Запускать приложение от root — плохая практика безопасности:
# если взломают приложение, злоумышленник получит root права в контейнере
# -g 1001 — GID (Group ID)
# -u 1001 — UID (User ID)
# -G nodegroup — добавляем в группу
# -s /bin/sh — оболочка пользователя
# -D — не создавать домашнюю директорию
RUN addgroup -g 1001 nodegroup && \
    adduser -u 1001 -G nodegroup -s /bin/sh -D nodeuser

WORKDIR /app

# Копируем файлы из этапа builder
# --from=builder — берём из первого этапа
# --chown=nodeuser:nodegroup — сразу передаём владение нашему пользователю
# Так файлы не будут принадлежать root
COPY --from=builder --chown=nodeuser:nodegroup /app .

# Переключаемся на не-root пользователя
# Все следующие команды (включая CMD) выполняются от этого пользователя
USER nodeuser

# Документируем что приложение слушает порт 3000
# EXPOSE не открывает порт сам по себе — это документация для docker run -p
EXPOSE 3000

# Команда запуска контейнера
# Форма массива (exec form) предпочтительна — процесс получает PID 1,
# корректно обрабатывает сигналы (SIGTERM при docker stop)
CMD ["node", "app.js"]
